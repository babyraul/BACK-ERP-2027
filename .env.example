# ─── App ──────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
LOG_LEVEL=info

# ─── PostgreSQL 18 ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:5432/NOMBRE_DB

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_y_seguro
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes del panel admin (React)
CORS_ORIGINS=https://TU_DOMINIO_ADMIN.COM

# ─── Sync (NUBE solo recibe, nunca inicia) ────────────────────────────────────
SYNC_API_KEY=clave_secreta_compartida_entre_local_y_nube
